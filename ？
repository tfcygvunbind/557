-- 优化精简版·传送UI（必生效）
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

-- 1. 性能优化：极简对象池
local ButtonPool = { inactive = {}, active = {} }
-- 获取按钮（复用/新建）
local function getButton()
    if #ButtonPool.inactive > 0 then
        local btn = table.remove(ButtonPool.inactive)
        btn.Visible = true
        table.insert(ButtonPool.active, btn)
        return btn
    end
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 24)
    btn.BackgroundColor3 = Color3.new(0.2, 0.2, 0.2)
    btn.TextColor3 = Color3.new(1, 1, 1)
    table.insert(ButtonPool.active, btn)
    return btn
end
-- 回收按钮
local function returnButtons()
    for _, btn in ipairs(ButtonPool.active) do
        btn.Visible = false
        btn.Parent = nil
        table.insert(ButtonPool.inactive, btn)
    end
    ButtonPool.active = {}
end

-- 2. 基础UI（滚动+关闭）
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Parent = PlayerGui

local Panel = Instance.new("Frame")
Panel.Size = UDim2.new(0, 150, 0, 250)
Panel.Position = UDim2.new(0, 20, 0, 20)
Panel.BackgroundColor3 = Color3.new(0.1, 0.1, 0.1)
Panel.Parent = ScreenGui

