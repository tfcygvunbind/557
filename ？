-- 提示框
local Tip = Instance.new("TextLabel")
Tip.Size = UDim2.new(1, -10, 0, 20)
Tip.Position = UDim2.new(0, 5, 0, 30)
Tip.BackgroundTransparency = 1
Tip.TextColor3 = Color3.new(1, 0.8, 0)
Tip.Parent = Panel

-- 3. 拖动功能
local isDragging = false
local startPos = Vector2.new()
local panelPos = Panel.Position

DragBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        isDragging = true
        startPos = input.Position
        panelPos = Panel.Position
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if isDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - startPos
        Panel.Position = UDim2.new(0, panelPos.X.Offset + delta.X, 0, panelPos.Y.Offset + delta.Y)
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        isDragging = false
    end
end)

-- 4. 核心传送（带错误提示）
local lastTele = 0
local function teleport(target)
    local now = os.clock()
    if now - lastTele < 2 then
        Tip.Text = "冷却中("..string.format("%.1f",2-(now-lastTele)).."s)"
        task.delay(2,function() Tip.Text = "" end)
        return
    end

    Tip.Text = "传送中..."
    local success, err = pcall(function()
        local myChar = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait(5)
        local targetChar = target.Character or target.CharacterAdded:Wait(5)
        local myRoot = myChar:FindFirstChild("HumanoidRootPart",5)
        local targetRoot = targetChar:FindFirstChild("HumanoidRootPart",5)
        local myHuman = myChar:FindFirstChildOfClass("Humanoid",5)

        if not myRoot or not targetRoot then error("部件缺失") end
        if myHuman and myHuman.Health <=0 then error("角色死亡") end

        myRoot.CFrame = targetRoot.CFrame + Vector3.new(0,0,2)
        lastTele = now
        Tip.Text = "传送至"..target.Name
    end)

    if not success then
        Tip.Text = "失败："..err
    end
    task.delay(2,function() Tip.Text = "" end)
end

-- 5. 更新按钮（对象池复用）
local function updateBtn()
    returnButtons()
    local targets = {}
    for _,p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then table.insert(targets,p) end
    end

    if #targets ==0 then
        Tip.Text = "无其他玩家"
        return
    end

    for i,p in ipairs(targets) do
        local btn = getButton()
        btn.Text = p.Name
        btn.LayoutOrder = i
        btn.Parent = ScrollFrame
        btn.MouseButton1Click:Connect(function()
            teleport(p)
        end)
    end
end

-- 初始化
updateBtn()
Players.PlayerAdded:Connect(updateBtn)
Players.PlayerRemoving:Connect(updateBtn)
task.spawn(function() while true do updateBtn() task.wait(3) end end)
