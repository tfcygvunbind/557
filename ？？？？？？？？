-- ========== 双端拖动（稳定版） ==========
local isDragging = false
local startInputPos = nil
local startWinPos = nil

Title.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        isDragging = true
        startInputPos = input.Position
        startWinPos = MainWin.Position
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if not isDragging then return end
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        local offset = input.Position - startInputPos
        MainWin.Position = UDim2.new(
            startWinPos.X.Scale, startWinPos.X.Offset + offset.X,
            startWinPos.Y.Scale, startWinPos.Y.Offset + offset.Y
        )
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        isDragging = false
    end
end)

