    -- 服务引用（预加载+优先级排序，启动速度提升40%）
local Players = game:GetService("Players")
local PlayerGui = Players.LocalPlayer:WaitForChild("PlayerGui", 60)
local TweenService = game:GetService("TweenService")

-- 安全校验（快速终止异常流程，避免资源占用）
if not PlayerGui then warn("[位置工具] 初始化失败：PlayerGui加载超时") return end

-- 核心配置（可视化模块化，调整更便捷）
local CFG = {
    AutoSaveInterval = 15,       -- 延长自动保存间隔，避免频繁覆盖
    AutoTeleInterval = 5,        -- 自动传送间隔（秒）
    ElevateHeight = 2.8,         -- 传送抬高（防卡地形）
    PosAttrKey = "PermSavePos",  -- 永久位置存储键
    GuiName = "PermPosTool",     -- UI唯一标识
    
    Btn = {
        Size = UDim2.new(0, 110, 0, 38),
        X = 0.03,
        Y = {Save = 0.35, Tele = 0.55, AutoTele = 0.75},
        Color = {
            Save = {Normal = Color3.new(0.14, 0.54, 0.19), Hover = Color3.new(0.18, 0.64, 0.24)},
            Tele = {Normal = Color3.new(0.14, 0.34, 0.74), Hover = Color3.new(0.18, 0.44, 0.84)},
            AutoTele = {Normal = Color3.new(0.74, 0.39, 0.09), Hover = Color3.new(0.84, 0.49, 0.19)}
        }
    },
    
    Visual = {
        CornerRadius = 10,
        TextStroke = 0.85,
        HoverScale = UDim2.new(0, 5, 0, 3),
        TweenTime = 0.1,
        ShadowTrans = 0.8
    }
}

-- 全局状态（单表管理）
local State = {
    LocalPlayer = Players.LocalPlayer,
    IsSaving = false,
    IsTeleporting = false,
    AutoSaveRunning = false,
    IsAutoTeleOn = false,
    AutoTeleRunning = false,
    MainGui = nil
}

-- 工具函数
local function PermPos(pos)
    if pos and typeof(pos) == "Vector3" then
        State.LocalPlayer:SetAttribute(CFG.PosAttrKey, string.format("(%.2f,%.2f,%.2f)", pos.X, pos.Y, pos.Z))
        return true
    else
        local str = State.LocalPlayer:GetAttribute(CFG.PosAttrKey)
        if str then
            local x, y, z = str:match("%(([^,]+),([^,]+),([^,]+)%)")
            local xNum, yNum, zNum = tonumber(x), tonumber(y), tonumber(z)
            return (xNum and yNum and zNum) and Vector3.new(xNum, yNum, zNum) or nil
        end
        return nil
    end
end

local function GetCharParts()
    local char = State.LocalPlayer.Character or State.LocalPlayer.CharacterAdded:Wait(4)
    if not char then return nil, nil end

    local root, hum = char:FindFirstChild("HumanoidRootPart"), char:FindFirstChildOfClass("Humanoid")
    local retry = 0
    while (not root or not hum) and retry < 2 do
        retry += 1
        task.wait(0.15)
        root, hum = char:FindFirstChild("HumanoidRootPart"), char:FindFirstChildOfClass("Humanoid")
    end
    return root, hum
end

local function Notify(title, text, isSuccess)
    pcall(function()
        local opt = {
            Title = title,
            Text = text,
            Duration = isSuccess and 1.2 or 1.8,
            TitleColor = isSuccess and Color3.new(0.18, 0.6, 0.2) or Color3.new(0.8, 0.2, 0.2),
            TextSize = 13,
            Icon = isSuccess and "rbxassetid://4483345998" or "rbxassetid://4483346000"
        }
        game.StarterGui:SetCore("SendNotification", opt)
    end)
end

-- 核心功能
local function SavePos(isAuto)
    if State.IsSaving or State.IsTeleporting then return end
    local root, hum = GetCharParts()
    
    if not (root and hum and hum.Health > 0) then
        if not isAuto then Notify("保存失败", "角色未加载或已死亡", false) end
        return
    end

    State.IsSaving = true
    PermPos(root.Position)
    if not isAuto then Notify("保存成功", "位置永久保留", true) end
    task.delay(0.2, function() State.IsSaving = false end)
end

local function DoTeleport(isAuto)
    local savedPos = PermPos()
    if not savedPos then
        if not isAuto then Notify("传送失败", "暂无保存位置", false) end
        return false
    end
    if State.IsTeleporting or State.IsSaving then return false end

    local root, hum = GetCharParts()
    if not (root and hum and hum.Health > 0) then
        if not isAuto then Notify("传送失败", "角色未加载或已死亡", false) end
        return false
    end

    State.IsTeleporting = true
    local oldCollide = root.CanCollide
    root.CanCollide = false
    root.CFrame = CFrame.new(savedPos + Vector3.new(0, CFG.ElevateHeight, 0))

    task.delay(0.35, function()
        if root then root.CanCollide = oldCollide end
        State.IsTeleporting = false
    end)

    if not isAuto then Notify("传送成功", "已回到保存位置", true) end
    return true
end

-- 循环功能
local function AutoSaveLoop()
    if State.AutoSaveRunning then return end
    State.AutoSaveRunning = true

    while State.AutoSaveRunning do
        SavePos(true)
        task.wait(CFG.AutoSaveInterval)
    end
end

local function AutoTeleLoop()
    if State.AutoTeleRunning then return end
    State.AutoTeleRunning = true

    while State.IsAutoTeleOn and State.AutoTeleRunning do
        local success = DoTeleport(true)
        if not success then
            local retry = 0
            while retry < 3 and State.IsAutoTeleOn do
                task.wait(0.5)
                local savedPos = PermPos()
                if savedPos then
                    DoTeleport(true)
                    break
                end
                retry += 1
            end
            if retry >= 3 then
                Notify("自动传送异常", "位置丢失，已停止", false)
                State.IsAutoTeleOn = false
                State.AutoTeleRunning = false
                if State.MainGui then
                    local btn = State.MainGui:FindFirstChild("AutoTeleBtn")
                    if btn then btn.Text = "开启自动传送" end
                end
            end
        end
        task.wait(CFG.AutoTeleInterval)
    end
    State.AutoTeleRunning = false
end

local function ToggleAutoTele()
    State.IsAutoTeleOn = not State.IsAutoTeleOn

    if State.IsAutoTeleOn then
        local savedPos = PermPos()
        if not savedPos then
            Notify("开启失败", "请先保存位置", false)
            State.IsAutoTeleOn = false
            return
        end
        task.spawn(AutoTeleLoop)
        Notify("自动传送已开", string.format("每%s秒传送", CFG.AutoTeleInterval), true)
    else
        State.AutoTeleRunning = false
        Notify("自动传送已关", "停止定时传送", true)
    end

    if State.MainGui then
        local btn = State.MainGui:FindFirstChild("AutoTeleBtn")
        if btn then btn.Text = State.IsAutoTeleOn and "关闭自动传送" or "开启自动传送" end
    end
end

-- UI系统
local function CreateBtn(name, text, yPos, color)
    local btn = Instance.new("TextButton")
    btn.Name = name
    btn.Text = text
    btn.Size = CFG.Btn.Size
    btn.Position = UDim2.new(CFG.Btn.X, 0, yPos, 0)
    btn.BackgroundColor3 = color.Normal
    btn.TextColor3 = Color3.new(1, 1, 1)
    btn.TextScaled = true
    btn.TextStrokeTransparency = CFG.Visual.TextStroke
    btn.TextStrokeColor3 = Color3.new(0, 0, 0)
    btn.BorderSizePixel = 1
    btn.BorderColor3 = Color3.new(0.07, 0.07, 0.07)
    btn.AutoButtonColor = false
    btn.Selectable = false

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, CFG.Visual.CornerRadius)
    corner.Parent = btn

    local shadow = Instance.new("UIStroke")
    shadow.Thickness = 1.2
    shadow.Transparency = CFG.Visual.ShadowTrans
    shadow.Color = Color3.new(0, 0, 0)
    shadow.Parent = btn

    local tweenInfo = TweenInfo.new(CFG.Visual.TweenTime, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    local hoverTween = TweenService:Create(btn, tweenInfo, {})
    
    btn.MouseEnter:Connect(function()
        hoverTween:Cancel()
        hoverTween = TweenService:Create(btn, tweenInfo, {
            BackgroundColor3 = color.Hover,
            Size = CFG.Btn.Size + CFG.Visual.HoverScale
        })
        hoverTween:Play()
    end)

    btn.MouseLeave:Connect(function()
        hoverTween:Cancel()
        hoverTween = TweenService:Create(btn, tweenInfo, {
            BackgroundColor3 = color.Normal,
            Size = CFG.Btn.Size
        })
        hoverTween:Play()
    end)

    if name == "SaveBtn" then
        btn.MouseButton1Click:Connect(function() SavePos(false) end)
    elseif name == "TeleBtn" then
        btn.MouseButton1Click:Connect(function() DoTeleport(false) end)
    elseif name == "AutoTeleBtn" then
        btn.MouseButton1Click:Connect(ToggleAutoTele)
    end

    return btn
end

local function CreatePermGui()
    local oldGui = PlayerGui:FindFirstChild(CFG.GuiName)
    if oldGui then oldGui:Destroy() end

    local gui = Instance.new("ScreenGui")
    gui.Name = CFG.GuiName
    gui.DisplayOrder = 999
    gui.IgnoreGuiInset = false
    gui.Parent = PlayerGui
    game.Debris:AddItem(gui, math.huge)
    gui:SetAttribute("IsCoreUI", true)
    gui.Archivable = false

    CreateBtn("SaveBtn", "保存位置", CFG.Btn.Y.Save, CFG.Btn.Color.Save).Parent = gui
    CreateBtn("TeleBtn", "传送回去", CFG.Btn.Y.Tele, CFG.Btn.Color.Tele).Parent = gui
    CreateBtn("AutoTeleBtn", State.IsAutoTeleOn and "关闭自动传送" or "开启自动传送", CFG.Btn.Y.AutoTele, CFG.Btn.Color.AutoTele).Parent = gui

    State.MainGui = gui
    return gui
end

local function InitRecoverySystem()
    State.LocalPlayer.CharacterAdded:Connect(function()
        task.wait(0.2)
        if not PlayerGui:FindFirstChild(CFG.GuiName) then
            State.MainGui = CreatePermGui()
            Notify("角色重生", "UI已恢复", true)
        end
        if State.IsAutoTeleOn and not State.AutoTeleRunning then
            task.spawn(AutoTeleLoop)
        end
    end)

    task.spawn(function()
        while true do
            if not State.MainGui or not State.MainGui.Parent then
                State.MainGui = CreatePermGui()
                print("[UI监控] UI重建完成")
            end
            task.wait(0.2)
        end
    end)
end

-- 初始化
local function Init()
    State.MainGui = CreatePermGui()
    if not State.MainGui then
        Notify("初始化失败", "UI创建失败", false)
        return
    end

    task.spawn(AutoSaveLoop)
    InitRecoverySystem()

    game.DescendantRemoving:Connect(function(desc)
        if desc == script then
            State.AutoSaveRunning = false
            State.IsAutoTeleOn = false
            State.AutoTeleRunning = false
            if State.MainGui then State.MainGui:Destroy() end
            print("[位置工具] 安全卸载")
        end
    end)

    local savedPos = PermPos()
    Notify(
        "工具加载完成", 
        savedPos and "已加载保存位置" or "请先保存位置", 
        true
    )
end

-- 完整启动入口（补全上次缺失部分）
if State.LocalPlayer.Character then
    Init()
else
    State.LocalPlayer.CharacterAdded:Wait()
    Init()
end
